# Runtime content mode: preview (explicit unreviewed banner) or reviewed (approved records only).
CONTENT_MODE=preview
AI_ENABLED=false
AI_IMAGES_ENABLED=false
# Upload path: one photo from the parent as the createAvatar reference (jpeg/png, 2 MB, never stored).
ALLOW_UPLOAD=false
AI_TEXT_MODEL=anthropic/claude-sonnet-5.5
AI_VISION_MODEL=anthropic/claude-sonnet-5.5
# Server-only. Never prefix with NEXT_PUBLIC_.
AI_GATEWAY_API_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
INTERNAL_API_TOKEN=
# Images (fal): the whole book is built around one reference child. Leave empty to draw pictures.
FAL_KEY=
FAL_REFERENCE_MODEL=fal-ai/flux-pro/kontext/text-to-image
FAL_EDIT_MODEL=fal-ai/gemini-3-pro-image-preview/edit
FAL_BACKGROUND_MODEL=fal-ai/birefnet/v2
